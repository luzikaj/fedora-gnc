// onehand-rules.kdl: where apps open and how (included from config.kdl).
//
// Workspaces "code", "web", "notes" and "vm" are declared in
// onehand-monitors.kdl, which `onehand-monitors` writes at every login,
// all on the main screen (the second screen shows the cheat sheet; Mod + End sends windows there):
//   code   -> Zed, Ghostty, JetBrains IDEs
//   web    -> Brave, Brave Nightly, Chrome
//   notes  -> Obsidian
//   vm     -> virt-manager, VM windows
// To stop an app moving, delete its `open-on-workspace` line.

// ---- your main browsers -> "web", two thirds wide
// (Brave, Brave Nightly, Chrome)
window-rule {
    match app-id=r#"^(brave-browser|brave-browser-nightly|google-chrome)$"#
    open-on-workspace "web"
    default-column-width { proportion 0.66667; }
}

// ---- editor and terminal -> "code"
window-rule {
    match app-id=r#"^dev\.zed\.Zed"#
    open-on-workspace "code"
    default-column-width { proportion 0.66667; }
}
window-rule {
    match app-id=r#"^(com\.mitchellh\.ghostty|foot)$"#
    open-on-workspace "code"
    default-column-width { proportion 0.5; }
}

// JetBrains IDEs (IntelliJ IDEA, PyCharm, Rider ...) -> "code"; their
// Toolbox launcher floats wherever you open it.
window-rule {
    match app-id=r#"^jetbrains-"#
    exclude app-id=r#"^jetbrains-toolbox$"#
    open-on-workspace "code"
    default-column-width { proportion 0.66667; }
}
window-rule {
    match app-id=r#"^jetbrains-toolbox$"#
    open-floating true
}

// ---- virtual machines -> "vm" (main screen): virt-manager and its VM
// windows, the standalone viewer, GNOME Boxes
window-rule {
    match app-id=r#"^(virt-manager|virt-viewer|remote-viewer|org\.gnome\.Boxes)$"#
    open-on-workspace "vm"
}

// ---- notes -> "notes"
window-rule {
    match app-id=r#"^(md\.obsidian\.Obsidian|obsidian)$"#
    open-on-workspace "notes"
    default-column-width { proportion 0.66667; }
}

// ---- small tools float above everything and don't take the keyboard focus
// Speech Note (dictation) must leave focus on the window you're dictating into.
window-rule {
    match app-id=r#"^(net\.mkiol\.SpeechNote|dsnote)$"#
    open-floating true
    open-focused false
}
window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
}

// ---- pop-ups that should never become a full column
window-rule {
    match title=r#"^Picture[- ]in[- ]Picture$"#
    open-floating true
}
window-rule {
    // File pickers (the portal's own windows)
    match app-id=r#"^xdg-desktop-portal"#
    open-floating true
}

// ---- the Welcome window (install, first steps): a floating box in the middle
window-rule {
    match app-id=r#"^onehanded\.welcome$"#
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 680; }
}
