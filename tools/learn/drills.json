{
  "_about": "Shortcut drills for the four learning weeks. tools/learn/build.py turns this into docs/learn/trainer.html and docs/learn/cheat-sheets.pdf. Keys are browser KeyboardEvent.key values; several keys = a sequence.",
  "decks": [
    {
      "id": "w1", "week": 1, "title": "The keyboard",
      "goal": "Find every letter and symbol without looking, and the three special touches.",
      "drill": [
        "5 min in Typing Tutor (launcher: Mod + ', type \"typing\")",
        "Trainer: Week 1, until 20 in a row are right",
        "Type 3 sentences with Polish letters (tap Right Alt, then the letter)",
        "Use sticky Shift for every capital today (tap Right Shift, then the letter)"
      ],
      "groups": [
        {"name": "Directions everywhere", "ctx": "", "items": [
          {"a": "Left", "k": ["e"]}, {"a": "Down", "k": ["h"]},
          {"a": "Up", "k": ["t"]}, {"a": "Right", "k": ["d"]}
        ]},
        {"name": "Polish letters", "ctx": "tap Right Alt, then", "items": [
          {"a": "ą", "k": ["a"]}, {"a": "ć", "k": ["c"]}, {"a": "ę", "k": ["e"]},
          {"a": "ł", "k": ["l"]}, {"a": "ń", "k": ["n"]}, {"a": "ó", "k": ["o"]},
          {"a": "ś", "k": ["s"]}, {"a": "ż", "k": ["z"]}, {"a": "ź", "k": ["x"]}
        ]},
        {"name": "Symbols", "ctx": "type", "items": [
          {"a": "-  (minus)", "k": ["-"]}, {"a": "_  (underscore)", "k": ["_"]},
          {"a": "=  (equals)", "k": ["="]}, {"a": ";  (semicolon)", "k": [";"]},
          {"a": ":  (colon)", "k": [":"]}, {"a": "/  (slash)", "k": ["/"]},
          {"a": "'  (apostrophe)", "k": ["'"]}, {"a": "\"  (quote)", "k": ["\""]},
          {"a": "[  (left bracket)", "k": ["["]}, {"a": "]  (right bracket)", "k": ["]"]},
          {"a": "$  (dollar)", "k": ["$"]}, {"a": "(  (left paren)", "k": ["("]},
          {"a": ")  (right paren)", "k": [")"]}, {"a": ".  (dot)", "k": ["."]},
          {"a": ",  (comma)", "k": [","]}
        ]},
        {"name": "Digits", "ctx": "type", "items": [
          {"a": "5", "k": ["5"]}, {"a": "6", "k": ["6"]}, {"a": "7", "k": ["7"]},
          {"a": "8", "k": ["8"]}, {"a": "9", "k": ["9"]}, {"a": "0", "k": ["0"]}
        ]}
      ]
    },
    {
      "id": "w2", "week": 2, "title": "niri: the desktop",
      "goal": "Open, find, move and close windows without the mouse.",
      "drill": [
        "Start every app with Mod + ' (no mouse)",
        "Trainer: Week 2, two rounds",
        "Arrange 3 windows on one workspace: Mod + o/u to move, Mod + l to size",
        "Visit code, web, notes with Mod + n / w; press Mod + Insert once"
      ],
      "groups": [
        {"name": "Basics", "ctx": "Mod +", "items": [
          {"a": "Launcher", "k": ["'"]}, {"a": "Terminal", "k": ["Enter"]},
          {"a": "Close window", "k": ["Backspace"]}, {"a": "All shortcuts", "k": ["Insert"]},
          {"a": "Lock screen", "k": ["Delete"]}, {"a": "Overview", "k": ["-"]}
        ]},
        {"name": "Focus", "ctx": "Mod +", "items": [
          {"a": "Focus column left", "k": ["e"]}, {"a": "Focus window below", "k": ["h"]},
          {"a": "Focus window above", "k": ["t"]}, {"a": "Focus column right", "k": ["d"]}
        ]},
        {"name": "Move", "ctx": "Mod +", "items": [
          {"a": "Move column left", "k": ["o"]}, {"a": "Move window down", "k": ["r"]},
          {"a": "Move window up", "k": ["s"]}, {"a": "Move column right", "k": ["u"]},
          {"a": "Pull window from the left into this column", "k": [";"]},
          {"a": "Push window out to the right", "k": ["="]}
        ]},
        {"name": "Size and view", "ctx": "Mod +", "items": [
          {"a": "Cycle column width", "k": ["l"]}, {"a": "Narrower", "k": ["m"]},
          {"a": "Wider", "k": ["f"]}, {"a": "Center column", "k": ["p"]},
          {"a": "Tabbed column", "k": ["/"]}, {"a": "Floating on/off", "k": ["k"]},
          {"a": "Switch focus: floating ↔ tiled", "k": ["j"]},
          {"a": "Fullscreen", "k": ["y"]}, {"a": "Maximize column", "k": ["b"]}
        ]},
        {"name": "Workspaces and screens", "ctx": "Mod +", "items": [
          {"a": "Workspace up", "k": ["n"]}, {"a": "Workspace down", "k": ["w"]},
          {"a": "Send column to workspace up", "k": ["v"]},
          {"a": "Send column to workspace down", "k": ["g"]},
          {"a": "Previous workspace", "k": ["PageUp"]},
          {"a": "Focus the other screen", "k": ["Home"]},
          {"a": "Send this window to the other screen (and back)", "k": ["End"]},
          {"a": "Second screen: wake / sleep", "k": ["q"]},
          {"a": "Send the workspace to the other screen", "k": ["z"]}
        ]},
        {"name": "Panels and voice", "ctx": "Mod +", "items": [
          {"a": "Notifications", "k": ["["]}, {"a": "Clipboard history", "k": ["]"]},
          {"a": "Dux settings", "k": ["PageDown"]},
          {"a": "Dictate into the window", "k": ["c"]}, {"a": "Stop dictating", "k": ["i"]},
          {"a": "Read clipboard aloud", "k": ["a"]}, {"a": "Stop reading", "k": ["x"]},
          {"a": "Pass all keys to the app (VMs)", "k": ["ScrollLock"]}
        ]}
      ]
    },
    {
      "id": "w3", "week": 3, "title": "Browser and terminal",
      "goal": "Browse with Vimium C and get around the shell with fish.",
      "drill": [
        "Read the news with Vimium only: e h t d to scroll, i to open links",
        "Trainer: Week 3, two rounds",
        "Find a page via bookmarks (f) and switch tabs with a / c",
        "In the terminal: z to a folder, Ctrl+R for an old command, accept a suggestion with →"
      ],
      "groups": [
        {"name": "Scroll and history", "ctx": "Vimium", "items": [
          {"a": "Scroll left", "k": ["e"]}, {"a": "Scroll down", "k": ["h"]},
          {"a": "Scroll up", "k": ["t"]}, {"a": "Scroll right", "k": ["d"]},
          {"a": "Page down", "k": ["r"]}, {"a": "Page up", "k": ["s"]},
          {"a": "To the top", "k": ["y"]}, {"a": "To the bottom", "k": ["b"]},
          {"a": "Back", "k": ["o"]}, {"a": "Forward", "k": ["u"]},
          {"a": "Reload", "k": ["="]}
        ]},
        {"name": "Tabs and links", "ctx": "Vimium", "items": [
          {"a": "Previous tab", "k": ["a"]}, {"a": "Next tab", "k": ["c"]},
          {"a": "Close tab", "k": ["k"]}, {"a": "Reopen closed tab", "k": ["j"]},
          {"a": "Open a link", "k": ["i"]}, {"a": "Open a link in a new tab", "k": ["n"]},
          {"a": "Copy a link's address", "k": ["w"]}
        ]},
        {"name": "Find and go", "ctx": "Vimium", "items": [
          {"a": "Address bar", "k": ["l"]}, {"a": "Find an open tab", "k": ["m"]},
          {"a": "Search bookmarks", "k": ["f"]}, {"a": "Find on the page", "k": ["/"]},
          {"a": "Next match", "k": ["v"]}, {"a": "Previous match", "k": ["g"]},
          {"a": "First text field", "k": [";"]}, {"a": "Show all Vimium keys", "k": ["'"]}
        ]},
        {"name": "fish shell", "ctx": "fish", "items": [
          {"a": "Accept the grey suggestion", "k": ["ArrowRight"]},
          {"a": "Short for nvim", "k": ["v"]}, {"a": "Short for git", "k": ["g"]},
          {"a": "Short for lazygit", "k": ["l", "g"]},
          {"a": "Jump to a folder you used before", "k": ["z"]},
          {"a": "Pick a folder from a list", "k": ["z", "i"]}
        ]}
      ]
    },
    {
      "id": "w4", "week": 4, "title": "The editor",
      "goal": "Move and edit in LazyVim (and Zed) with the same keys.",
      "drill": [
        "Edit one real file only with the keyboard",
        "Trainer: Week 4, two rounds",
        "Practise k (delete) with motions: k l, k j, kk",
        "Open two splits and move between them with Space w + e h t d"
      ],
      "groups": [
        {"name": "Move", "ctx": "LazyVim", "items": [
          {"a": "Left", "k": ["e"]}, {"a": "Down", "k": ["h"]},
          {"a": "Up", "k": ["t"]}, {"a": "Right", "k": ["d"]},
          {"a": "Next word", "k": ["w"]}, {"a": "Back a word", "k": ["b"]},
          {"a": "End of word", "k": ["l"]}, {"a": "End of WORD", "k": ["L"]},
          {"a": "Till character", "k": ["j"]}, {"a": "Find character", "k": ["f"]},
          {"a": "Top of file", "k": ["g", "g"]}, {"a": "Bottom of file", "k": ["G"]}
        ]},
        {"name": "Edit", "ctx": "LazyVim", "items": [
          {"a": "Insert", "k": ["i"]}, {"a": "Append", "k": ["a"]},
          {"a": "New line below", "k": ["o"]}, {"a": "Delete (then a motion)", "k": ["k"]},
          {"a": "Delete line", "k": ["k", "k"]}, {"a": "Change", "k": ["c"]},
          {"a": "Undo", "k": ["u"]}, {"a": "Repeat last change", "k": ["."]},
          {"a": "Yank (copy) line", "k": ["y", "y"]}, {"a": "Paste", "k": ["p"]},
          {"a": "Select", "k": ["v"]}, {"a": "Select lines", "k": ["V"]},
          {"a": "Search", "k": ["/"]}, {"a": "Next match", "k": ["n"]}
        ]},
        {"name": "View", "ctx": "LazyVim", "items": [
          {"a": "Scroll a line down", "k": ["z", "h"]}, {"a": "Scroll a line up", "k": ["z", "t"]},
          {"a": "Half page down", "k": ["z", "H"]}, {"a": "Half page up", "k": ["z", "T"]},
          {"a": "Cursor line to top", "k": ["z", "u"]}, {"a": "Center the cursor line", "k": ["z", "z"]}
        ]},
        {"name": "Windows, buffers, files", "ctx": "LazyVim", "items": [
          {"a": "Window left", "k": [" ", "w", "e"]}, {"a": "Window below", "k": [" ", "w", "h"]},
          {"a": "Window above", "k": [" ", "w", "t"]}, {"a": "Window right", "k": [" ", "w", "d"]},
          {"a": "Move window left", "k": [" ", "w", "E"]}, {"a": "Close window", "k": [" ", "w", "k"]},
          {"a": "Previous buffer", "k": ["E"]}, {"a": "Next buffer", "k": ["D"]},
          {"a": "Close buffer", "k": [" ", "b", "d"]}, {"a": "Find files", "k": [" ", " "]},
          {"a": "File explorer", "k": [" ", "e"]}, {"a": "Search text in files", "k": [" ", "/"]},
          {"a": "lazygit", "k": [" ", "g", "g"]}
        ]}
      ]
    }
  ]
}
